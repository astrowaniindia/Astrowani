# Node modules (all subprojects)
node_modules/
**/node_modules/

# Gradle build cache and outputs
.gradle_cache/
**/.gradle/
**/build/
**/.gradle_cache/

# React Native build outputs
**/android/app/build/
**/android/build/
**/ios/build/
**/ios/Pods/

# Environment files (secrets)
.env
.env.local
.env.production
**/.env
**/.env.local
**/.env.production

# Lock files (optional - remove if you want to keep them)
# yarn.lock
# package-lock.json

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.suo
*.user

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android keystore (keep secret)
*.keystore
*.jks

# Firebase service-account keys (keep secret — backend push credential)
**/*firebase-adminsdk*.json
**/firebase-service-account*.json

# Metro bundler cache
**/.metro-health-check*

# Temporary files
tmp/
temp/

# Python venv for the self-hosted background-removal service
# (astrowani-backend/bg-removal-service/) — created on the VPS by the deploy
# workflow, never committed. requirements.txt + the .tflite model ARE committed.
**/bg-removal-service/venv/
**/__pycache__/
*.pyc

# Source photography for the shop storefront (astrowani-store-images/) — the original
# multi-megabyte PNGs the site's images were cut from. ~65 MB and nothing builds from
# them: astrowani-shop/assets/ holds the optimised, content-hashed derivatives that
# actually ship. Keep the originals backed up outside git.
astrowani-store-images/*.png

# Raw supplier/reference image dumps. Working material, not site assets: the shop serves
# per-product images from astrowani-shop/assets/vastu/ instead.
astrowani-shop/assets/vastu products/
# Full-resolution tile sources for the Vastu categories (6-8 MB PNGs each). The shop serves
# the 3:2 JPEGs generated from them (assets/vastu-cat-*.jpg); these stay local so a stray
# `git add -A` cannot drop 43 MB of masters into the repo.
astrowani-shop/assets/crystals.png
astrowani-shop/assets/feng shui.png
astrowani-shop/assets/gifts.png
astrowani-shop/assets/handicrafts.png
astrowani-shop/assets/pyramids.png
astrowani-shop/assets/vastu enhancer.png

# Ad creative working directory (~257 MB, 131 files): generated hero/banner/icon art and
# campaign exports for Meta and Google Ads. Nothing in the repo builds from it and the
# campaigns are managed in the ad dashboards, so keep the masters backed up outside git.
ad-assets/

# Built APKs/AABs. Release artifacts live in D:\Astrowani-Releases\ (see CLAUDE.md "CE"),
# deliberately outside the repo so a 50-100 MB binary cannot be committed by a stray
# `git add -A`. Debug builds are disposable.
*.apk
*.aab

# Loose screenshots dropped in the repo root while driving the emulator or the admin in a
# browser. They are scratch: put anything worth keeping in the session scratchpad instead.
/screen.png
/emulator_screen.png
/current_emulator.png
/customer_screen.png
/customer_live.png
/login_screen.png
/android12_screen.png
