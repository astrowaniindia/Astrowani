# Node modules (all subprojects)
node_modules/
**/node_modules/

# Gradle build cache and outputs
.gradle_cache/
**/.gradle/
**/build/
**/.gradle_cache/

# React Native build outputs
**/android/app/build/
**/android/build/
**/ios/build/
**/ios/Pods/

# Environment files (secrets)
.env
.env.local
.env.production
**/.env
**/.env.local
**/.env.production

# Lock files (optional - remove if you want to keep them)
# yarn.lock
# package-lock.json

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.suo
*.user

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android keystore (keep secret)
*.keystore
*.jks

# Firebase service-account keys (keep secret — backend push credential)
**/*firebase-adminsdk*.json
**/firebase-service-account*.json

# Metro bundler cache
**/.metro-health-check*

# Temporary files
tmp/
temp/

# Python venv for the self-hosted background-removal service
# (astrowani-backend/bg-removal-service/) — created on the VPS by the deploy
# workflow, never committed. requirements.txt + the .tflite model ARE committed.
**/bg-removal-service/venv/
**/__pycache__/
*.pyc

# Source photography for the shop storefront (astrowani-store-images/) — the original
# multi-megabyte PNGs the site's images were cut from. ~65 MB and nothing builds from
# them: astrowani-shop/assets/ holds the optimised, content-hashed derivatives that
# actually ship. Keep the originals backed up outside git.
astrowani-store-images/*.png
