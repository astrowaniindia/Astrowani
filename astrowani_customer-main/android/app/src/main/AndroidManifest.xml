    <uses-permission android:name="android.permission.INTERNET" />
  
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    
 
 <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

 <!-- OPTIONAL PERMISSIONS, REMOVE WHATEVER YOU DO NOT NEED -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
  <uses-permission android:name="android.permission.USE_FINGERPRINT"/>


  <!-- These require runtime permissions on M -->
  <uses-permission android:name="android.permission.CAMERA"/>

  <uses-permission android:name="android.permission.READ_CONTACTS"/>
  <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
  <uses-permission android:name="android.permission.READ_CALENDAR"/>
  <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
<uses-permission android:name="android.permission.VIBRATE" />
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

  <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
  <!-- to use Forground service -->


  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <!-- Required from Android 14 (API 34) to run a foreground service of type
       "microphone". Without it Android silences the mic as soon as the app leaves the
       foreground, so a backgrounded call stopped transmitting voice until the user
       came back. An `ongoing: true` notification (activeSessionNotification.js) looks
       like a call notification but grants no such privilege. See
       CallForegroundService.kt. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  
  <!-- Foreground location, declared deliberately and requested at runtime only when the
       customer taps "Use my current location" while saving a delivery address (see
       screens/Remedies/AddressForm.js). It also lets the Shubh Muhurat card obtain the
       coordinates its timings need — that call existed already but could never succeed
       while these were stripped.
       PLAY STORE: this needs a location-permission declaration in the console. It is
       foreground-only and user-initiated; BACKGROUND location stays stripped below, since
       nothing in this app has any business tracking a customer who isn't using it. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

  <uses-sdk tools:overrideLibrary="com.rnenxrtc"/>
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/BootTheme"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
  <!-- react-native-push-notification's own native FCM listener (RNPushNotificationListenerService)
       is deliberately NOT registered here. It would compete with @react-native-firebase/messaging
       for the same com.google.firebase.MESSAGING_EVENT intent and intercept messages before our
       own onMessage/setBackgroundMessageHandler (index.js) ever ran, silently swallowing every
       push. We only use react-native-push-notification's local-notification display API
       (PushNotification.localNotification in src/utils/PushNotification.js), not its FCM receiver. -->
  <!-- Status-bar icon FCM uses for notifications delivered while the app is backgrounded/killed
       (Android always renders this as a plain white silhouette — this is the OS-mandated style,
       not a design choice we can change). -->
  <meta-data
    android:name="com.google.firebase.messaging.default_notification_icon"
    android:resource="@drawable/ic_notification" />

  <!-- Keeps the microphone working while a call is in progress and the app is
       backgrounded. The `microphone` type is the part that matters: from Android 14
       it is the ONLY way to keep capturing audio outside the foreground.
       exported=false — nothing outside this app may start it. -->
  <service
      android:name=".CallForegroundService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    </application>
</manifest>
