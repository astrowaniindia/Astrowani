<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- Cold-start splash theme (androidx.core:core-splashscreen — a compat wrapper around
         the Android 12+ SplashScreen API that also works pre-31). Without this override,
         API 31+ generates its own default splash with a white background and a heavily
         inset launcher icon — that's what produced the thick white border around the logo.
         MainActivity switches back to AppTheme in onCreate() right after this is shown. -->
    <style name="BootTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
