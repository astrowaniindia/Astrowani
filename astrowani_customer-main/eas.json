{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "ios": {
        "credentialsSource": "remote",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "remote",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "RCT_NEW_ARCH_ENABLED": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826113999"
      }
    }
  }
}
