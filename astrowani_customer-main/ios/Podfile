# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions: only the handlers listed in setup_permissions! are
# compiled into the binary. Anything omitted is absent entirely, which is what
# keeps App Review from asking why the app links a permission it never uses.
# The five below are exactly the ones this app needs:
#   Microphone / Camera  -> WebRTC voice + video consultations
#   Notifications        -> FCM prompt (iOS needs an explicit ask; Android
#                           handles this via POST_NOTIFICATIONS)
#   LocationWhenInUse    -> delivery address + Shubh Muhurat timings
#   PhotoLibrary         -> profile picture
require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, min_ios_version_supported   # 15.1 for RN 0.77 - keep the Xcode
                                           # project's IPHONEOS_DEPLOYMENT_TARGET
                                           # matching, or pods and app disagree.
prepare_react_native_project!

setup_permissions([
  'Camera',
  'LocationWhenInUse',
  'Microphone',
  'Notifications',
  'PhotoLibrary',
])

# ---------------------------------------------------------------------------
# LINKAGE - this was settled empirically over several EAS builds. Read before
# changing it.
#
# `pod install` initially failed with:
#   [!] The following Swift pods cannot yet be integrated as static libraries:
#       FirebaseCoreInternal depends upon GoogleUtilities, which does not define modules
#       RNSentry            depends upon React-hermes,    which does not define modules
#
# CocoaPods offers two fixes for that. We use the SECOND one, and the choice
# matters:
#
#   (a) use_frameworks! :linkage => :static  -- TRIED, AND IT BROKE THE LINK.
#       It got pod install passing, then failed at link time with
#         Undefined symbol: _OBJC_PROTOCOL_$_ExternalWalletSelectionProtocol
#         referenced from RNRazorpayCheckout
#       react-native-razorpay pulls in THREE vendored xcframeworks (Razorpay,
#       RazorpayCore, RazorpayStandard) and under static frameworks they do not
#       all reach the app's link line. Note only that one symbol was missing --
#       other protocols from the same header resolved -- so this is a vendored
#       framework propagation problem, not a missing architecture.
#
#   (b) use_modular_headers! -- what we do. It makes the ObjC pods emit module
#       maps so the Swift pods can import them, while leaving linkage as static
#       LIBRARIES, which is what react-native-razorpay's vendored frameworks
#       expect.
#
# Sentry's own podspec corroborates (b): its RNSentrySwiftLinkStub.swift, the
# file that makes RNSentry a Swift pod at all, is documented as
# "only needed when linking Sentry.xcframework's Swift symbols into a dynamic
# framework anyway". We are not doing that, so forcing frameworks to satisfy it
# was solving the wrong problem.
#
# DO NOT set USE_FRAMEWORKS for this app. The env hook below is kept only as an
# escape hatch, and `:linkage => :dynamic` in particular is known not to work
# with react-native-webrtc.
#
# Never commit a Podfile.lock produced by an experiment that did not build.
# ---------------------------------------------------------------------------
use_modular_headers!

# Only meaningful if Firebase is ever built as a static framework (the
# use_frameworks path above, which we do not use). Harmless otherwise.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AstrologyApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AstrologyAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
