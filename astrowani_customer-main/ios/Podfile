# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions: only the handlers listed in setup_permissions! are
# compiled into the binary. Anything omitted is absent entirely, which is what
# keeps App Review from asking why the app links a permission it never uses.
# The five below are exactly the ones this app needs:
#   Microphone / Camera  -> WebRTC voice + video consultations
#   Notifications        -> FCM prompt (iOS needs an explicit ask; Android
#                           handles this via POST_NOTIFICATIONS)
#   LocationWhenInUse    -> delivery address + Shubh Muhurat timings
#   PhotoLibrary         -> profile picture
require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, min_ios_version_supported   # 15.1 for RN 0.77 - keep the Xcode
                                           # project's IPHONEOS_DEPLOYMENT_TARGET
                                           # matching, or pods and app disagree.
prepare_react_native_project!

setup_permissions([
  'Camera',
  'LocationWhenInUse',
  'Microphone',
  'Notifications',
  'PhotoLibrary',
])

# ---------------------------------------------------------------------------
# LINKAGE - this was settled empirically over several EAS builds. Read before
# changing it.
#
# `pod install` initially failed with:
#   [!] The following Swift pods cannot yet be integrated as static libraries:
#       FirebaseCoreInternal depends upon GoogleUtilities, which does not define modules
#       RNSentry            depends upon React-hermes,    which does not define modules
#
# BOTH of CocoaPods' suggested blanket fixes were tried, and BOTH broke the
# build in a different place. Do not reach for either of them again:
#
#   (a) use_frameworks! :linkage => :static  -- got pod install passing, then
#       failed at LINK time:
#         Undefined symbol: _OBJC_PROTOCOL_$_ExternalWalletSelectionProtocol
#         referenced from RNRazorpayCheckout
#       react-native-razorpay pulls in three vendored xcframeworks (Razorpay,
#       RazorpayCore, RazorpayStandard) which are DYNAMIC, and a static
#       framework cannot contain a dynamic one, so they never reach the app's
#       link line. Only that ONE symbol was undefined -- other protocols from
#       the same header resolved -- which is what identifies it as vendored
#       framework propagation rather than a missing architecture.
#
#   (b) use_modular_headers!  (global) -- failed to COMPILE React Native itself:
#         Redefinition of module 'ReactCommon' (in target React-RCTAppDelegate)
#         Could not build module 'Foundation' / 'UIKit' / 'DarwinFoundation'
#       React Native ships its own module maps for some pods; generating them
#       globally produces duplicates.
#
# So: DEFAULT static-library linkage, with the two offending dependencies fixed
# individually.
#
#   FirebaseCoreInternal -> GoogleUtilities
#       fixed by the `pod 'GoogleUtilities', :modular_headers => true` line in
#       the target block below. GoogleUtilities is a transitive Firebase
#       dependency that nothing else declares, so declaring it here is safe and
#       is the documented fix.
#
#   RNSentry -> React-hermes
#       React-hermes is declared by use_react_native!, so it cannot be
#       re-declared here with modular headers. Fixed instead by removing the one
#       file that makes RNSentry a Swift pod at all --
#       ios/RNSentrySwiftLinkStub.swift -- in scripts/apply-native-patches.js.
#       That file's own comment says it is only needed "when linking a dynamic
#       RNSentry framework", which we do not do; it is a single unused constant
#       that exists purely to force Swift runtime compatibility libs to link.
#
# DO NOT set USE_FRAMEWORKS for this app. The env hook below is kept only as an
# escape hatch, and `:linkage => :dynamic` in particular is known not to work
# with react-native-webrtc.
#
# Never commit a Podfile.lock produced by an experiment that did not build.
# ---------------------------------------------------------------------------

# Only meaningful if Firebase is ever built as a static framework (the
# use_frameworks path above, which we do not use). Harmless otherwise.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AstrologyApp' do
  config = use_native_modules!

  # Fixes: "The Swift pod `FirebaseCoreInternal` depends upon `GoogleUtilities`,
  # which does not define modules." GoogleUtilities is a transitive Firebase
  # dependency that no other Podfile line declares, so declaring it here to turn
  # on module-map generation is safe and does not duplicate anything.
  # Targeted deliberately - see the LINKAGE note above for why the global
  # use_modular_headers! cannot be used.
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AstrologyAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
