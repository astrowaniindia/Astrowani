<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.CAMERA" />
<uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- REMOVED 2026-09-05, all six verified unused before deletion (zero references
         across src/ and the app's own Kotlin, and no dependency manifest declares them):
           SYSTEM_ALERT_WINDOW, WRITE_SETTINGS  — Play "special access" permissions that
             attract review scrutiny; nothing here draws over other apps or writes system
             settings.
           USE_FINGERPRINT, USE_BIOMETRIC       — no biometric library is even installed.
           READ_EXTERNAL_STORAGE                — nothing reads the gallery directly; the
             image pickers use the system picker.
           READ_PHONE_STATE                     — react-native-callkeep declares this,
             but react-native.config.js keeps callkeep OFF Android entirely (CallKit is an
             iOS-only problem), so its manifest never merges here. Confirmed against the
             merged release manifest: with our line gone, the permission is gone.
         They came from a scaffolding block originally labelled "OPTIONAL PERMISSIONS,
         REMOVE WHATEVER YOU DO NOT NEED" and were never pruned. -->

    <!-- Comes in unbounded from react-native-fs / image-crop-picker / audio-recorder-player.
         Capped here because scoped storage makes it a no-op from API 29 anyway, so an
         uncapped declaration only widens what Play sees us asking for. tools:node="replace"
         is required — without it the merger keeps the libraries' unbounded version. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:node="replace"/>
    <!-- Declared only to CAP it. Nothing here reads the gallery directly, but the
         manifest merger IMPLIES this permission from WRITE_EXTERNAL_STORAGE above
         (a legacy compatibility rule — confirmed in the merger's own blame report:
         "IMPLIED ... reason: com.dooboolab.audiorecorderplayer requested
         WRITE_EXTERNAL_STORAGE"). An implied permission arrives with NO maxSdkVersion,
         so without this line the cap above achieves only half the job. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:node="replace"/>

    <!-- To use Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Required from Android 14 (API 34) to run a foreground service of type
         "microphone". Without it, Android silences the mic as soon as the app leaves
         the foreground, so the astrologer's voice stopped reaching the customer when
         they switched apps. See CallForegroundService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- A foreground service must post a notification, and from Android 13 that
         needs this permission. The vendor app never declared it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required (Android 14+) for the incoming-call notification's fullScreenAction to
         actually launch the app over the lock screen / other apps instead of silently
         degrading to a normal tap-to-open notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!-- Remove merged location permissions that are injected by dependencies -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      android:usesCleartextTraffic="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- Status-bar icon FCM uses for notifications delivered while the app is backgrounded/killed
           (Android always renders this as a plain white silhouette — OS-mandated style). -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />

      <!-- Keeps the microphone working while a call is in progress and the app is
           backgrounded. The `microphone` type is the part that matters: from Android
           14 it is the ONLY way to keep capturing audio outside the foreground.
           exported=false — nothing outside this app may start it. -->
      <service
          android:name=".CallForegroundService"
          android:enabled="true"
          android:exported="false"
          android:foregroundServiceType="microphone" />
    </application>
</manifest>
