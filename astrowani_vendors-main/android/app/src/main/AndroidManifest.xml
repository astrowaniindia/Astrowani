<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.CAMERA" />
<uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- REMOVED 2026-09-05, all six verified unused before deletion (zero references
         across src/ and the app's own Kotlin, and no dependency manifest declares them):
           SYSTEM_ALERT_WINDOW, WRITE_SETTINGS  — Play "special access" permissions that
             attract review scrutiny; nothing here draws over other apps or writes system
             settings.
           USE_FINGERPRINT, USE_BIOMETRIC       — no biometric library is even installed.
           READ_EXTERNAL_STORAGE                — nothing reads the gallery directly; the
             image pickers use the system picker.
           READ_PHONE_STATE                     — react-native-callkeep declares this,
             but react-native.config.js keeps callkeep OFF Android entirely (CallKit is an
             iOS-only problem), so its manifest never merges here. Confirmed against the
             merged release manifest: with our line gone, the permission is gone.
         They came from a scaffolding block originally labelled "OPTIONAL PERMISSIONS,
         REMOVE WHATEVER YOU DO NOT NEED" and were never pruned. -->

    <!-- Comes in unbounded from react-native-fs / image-crop-picker / audio-recorder-player.
         Capped here because scoped storage makes it a no-op from API 29 anyway, so an
         uncapped declaration only widens what Play sees us asking for. tools:node="replace"
         is required — without it the merger keeps the libraries' unbounded version. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:node="replace"/>
    <!-- Declared only to CAP it. Nothing here reads the gallery directly, but the
         manifest merger IMPLIES this permission from WRITE_EXTERNAL_STORAGE above
         (a legacy compatibility rule — confirmed in the merger's own blame report:
         "IMPLIED ... reason: com.dooboolab.audiorecorderplayer requested
         WRITE_EXTERNAL_STORAGE"). An implied permission arrives with NO maxSdkVersion,
         so without this line the cap above achieves only half the job. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:node="replace"/>

    <!-- To use Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Required from Android 14 (API 34) to run a foreground service of type
         "microphone". Without it, Android silences the mic as soon as the app leaves
         the foreground, so the astrologer's voice stopped reaching the customer when
         they switched apps. See CallForegroundService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- Live broadcast in the background: Android 14+ stops camera capture for any app that
         is not in the foreground unless a foreground service of type "camera" is running. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <!-- Chat in the background: keeps the app's socket alive so a chat is not cut while the
         astrologer is in another app. See CallForegroundService.kt (mode "chat"). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Ringing for an incoming call/chat request even with the app backgrounded or fully
         killed. Android 14+ requires this specific permission to start a "phoneCall" type
         foreground service; that type is one of the few Android permits starting from the
         background at all, and only in response to a high-priority FCM message (which the
         backend already sends — see astrowani-backend/src/push.js). See
         RingingCallService.kt for why this exists: without a real foreground service, the
         process (and any ringtone playing in it) can be reclaimed by Android moments after
         the background push handler returns. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <!-- Required ALONGSIDE FOREGROUND_SERVICE_PHONE_CALL — Android additionally demands
         either this permission or the DIALER role before it will start a `phoneCall`
         type foreground service at all. Measured on-device: without it, startForeground()
         throws immediately and RingingCallService silently falls back to nothing, which is
         why the first attempt still played the old sound. A normal, auto-granted
         permission — no user prompt, no Telecom/ConnectionService registration needed. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <!-- A foreground service must post a notification, and from Android 13 that
         needs this permission. The vendor app never declared it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required (Android 14+) for the incoming-call notification's fullScreenAction to
         actually launch the app over the lock screen / other apps instead of silently
         degrading to a normal tap-to-open notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Draws a persistent incoming-call overlay on top of other apps. The regular heads-up
         notification auto-dismisses after ~5 seconds (Android platform behavior); this lets
         RingingCallService show a floating Accept/Reject banner that stays visible until the
         astrologer acts or the caller gives up. Requires the user to grant "Display over
         other apps" in system Settings once (prompted on first incoming request). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- Remove merged location permissions that are injected by dependencies -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

    <!-- enableOnBackInvokedCallback=false: targetSdk 36 turns predictive back ON by default,
         and then Android 16 never calls Activity.onBackPressed() - the only path React Native
         0.77's ReactActivity uses to reach JS BackHandler. Without this, every BackHandler in
         the app is silently inert on Android 16 (measured on an Android 16 emulator). -->
    <application
      android:enableOnBackInvokedCallback="false"
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- Status-bar icon FCM uses for notifications delivered while the app is backgrounded/killed
           (Android always renders this as a plain white silhouette — OS-mandated style). -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />

      <!-- Keeps the microphone working while a call is in progress and the app is
           backgrounded. The `microphone` type is the part that matters: from Android
           14 it is the ONLY way to keep capturing audio outside the foreground.
           exported=false — nothing outside this app may start it. -->
      <service
          android:name=".CallForegroundService"
          android:enabled="true"
          android:exported="false"
          android:foregroundServiceType="microphone|camera|dataSync" />
      <!-- Rings the real system ringtone for an incoming request, kept alive natively (no
           dependency on the JS engine surviving) whether the app is backgrounded or fully
           killed. exported=false — nothing outside this app may start it. -->
      <service
          android:name=".RingingCallService"
          android:enabled="true"
          android:exported="false"
          android:foregroundServiceType="phoneCall" />
    </application>
</manifest>
