# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported   # 15.1 for RN 0.77 - keep the Xcode
                                           # project's IPHONEOS_DEPLOYMENT_TARGET
                                           # matching, or pods and app disagree.
prepare_react_native_project!

# ---------------------------------------------------------------------------
# NOTE: there is deliberately NO setup_permissions! block here.
#
# The customer app's Podfile has one because react-native-permissions is a
# dependency there. This app does NOT have that package installed at all, so
# adding `require_relative '../node_modules/react-native-permissions/...'`
# would abort `pod install` with a file-not-found before anything else runs.
#
# It is not needed for correctness either: iOS prompts for the microphone and
# camera automatically on the first getUserMedia call, and the denial path is
# now handled explicitly in EnxScreenVoice / EnxScreenVideo / GoLiveScreen.
# If react-native-permissions is ever added to this app, the block goes right
# here, listing Camera / Microphone / Notifications / PhotoLibrary (this app
# uses NO location - verified, there is no Geolocation usage in src/).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# FIRST-BUILD TROUBLESHOOTING - read this before changing anything here.
#
# This app links react-native-webrtc + @react-native-firebase/* +
# react-native-image-crop-picker + react-native-audio-recorder-player +
# @notifee/react-native + react-native-fs. Try in this order, changing ONE
# thing at a time:
#
#   1. Plain `pod install` (this file as-is). Firebase's iOS SDK supports
#      static libraries, so this usually just works. Try it first.
#
#   2. If Swift/modular-header errors appear (typically from
#      FirebaseCoreInternal or GoogleUtilities), rebuild with static
#      frameworks:
#         USE_FRAMEWORKS=static pod install
#      The `linkage` block below already reads that env var, and
#      $RNFirebaseAsStaticFramework is set for exactly this case.
#
#   3. react-native-image-crop-picker is the most likely straggler under
#      static frameworks - it vendors TOCropViewController/QBImagePicker. If it
#      is the only thing failing, give it `:modular_headers => true` rather
#      than changing global linkage.
#
#   4. Do NOT reach for `use_frameworks! :linkage => :dynamic` -
#      react-native-webrtc does not cooperate with it.
#
# All of this app's patches/ are Android-only (verified: zero ios/ references),
# so patch-package is not a factor in an iOS build failure.
#
# Never commit a Podfile.lock produced by an experiment that did not build.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LINKAGE - settled empirically on the customer app; kept identical here so the
# two apps do not diverge. See that Podfile for the full reasoning.
#
# Short version: pod install fails without this because RNSentry (Swift) needs
# React-hermes to define modules, and FirebaseCoreInternal (Swift) needs the
# same of GoogleUtilities. use_frameworks! :linkage => :static also fixes that,
# but it broke linking of vendored xcframeworks on the customer app, so we use
# module maps and keep static LIBRARY linkage instead.
#
# DO NOT set USE_FRAMEWORKS. The env hook below is only an escape hatch, and
# :dynamic in particular does not work with react-native-webrtc.
# ---------------------------------------------------------------------------
# Required when Firebase is built as a static framework (path 2 above).
# Harmless otherwise.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# ---------------------------------------------------------------------------
# Build ONLY the Firebase/Google pods as static FRAMEWORKS, leaving every other
# pod a static library. Settled empirically on the customer app - see that
# Podfile for the full reasoning. Short version:
#   * use_frameworks! globally breaks vendored DYNAMIC xcframeworks.
#   * use_modular_headers! globally duplicates React Native's own module maps.
#   * :modular_headers => true one pod at a time just walks the error down the
#     Firebase dependency chain, one 8-minute build per pod.
# A static framework defines a module by construction, so flipping the whole
# Firebase/Google subtree at once satisfies all of them without touching React
# Native or any other pod.
# ---------------------------------------------------------------------------
$FirebaseStaticFrameworkPrefixes = ['Firebase', 'Google', 'Abseil', 'BoringSSL', 'gRPC', 'leveldb']
$FirebaseStaticFrameworkExact = ['nanopb', 'PromisesObjC', 'PromisesSwift', 'GTMSessionFetcher']

pre_install do |installer|
  installer.pod_targets.each do |pod|
    next unless $FirebaseStaticFrameworkPrefixes.any? { |p| pod.name.start_with?(p) } ||
                $FirebaseStaticFrameworkExact.include?(pod.name)
    Pod::UI.puts "Building #{pod.name} as a static framework (Firebase module requirement)".green
    def pod.build_type
      Pod::BuildType.static_framework
    end
  end
end
target 'AstroIndia_Astrologers' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AstroIndia_AstrologersTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # ───────────────────────────────────────────────────────────────────────
    # Raise every pod target to the app's own minimum (15.1). Identical to the
    # customer app's Podfile, and added here BEFORE this app's first iOS build
    # rather than after it failed: same React Native version, same Firebase and
    # RN pods, same 15.1 app target, so it would have died the same way.
    #
    # The failure it prevents (seen on the customer app, 2026-10-23):
    #   The iOS deployment target 'IPHONEOS_DEPLOYMENT_TARGET' is set to 9.0,
    #   but the range of supported deployment target versions is 15.0 to 27.1.x.
    #   (in target 'RNCAsyncStorage-RNCAsyncStorage_resources' from project 'Pods')
    #
    # Those are CocoaPods-GENERATED privacy-manifest and resource-bundle
    # targets, which inherit each pod's own ancient minimum instead of ours.
    # Older Xcode warned; the Xcode behind `image: "latest"` errors, at the very
    # end of the build. Raising them is safe because the app is already 15.1.
    #
    # Both loops are needed: resource bundles live in the Pods project normally,
    # but in per-pod subprojects when multiple pod projects are enabled.
    deployment_target = '15.1'
    bump = lambda do |project|
      project.targets.each do |target|
        target.build_configurations.each do |build_config|
          current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
          if current.to_f < deployment_target.to_f
            build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = deployment_target
          end
        end
      end
      project.save
    end


    # ───────────────────────────────────────────────────────────────────────
    # Force FMT_USE_CONSTEVAL off in the fmt pod.
    #
    # WHY THIS IS NOT OPTIONAL: Apple refuses uploads built with anything older
    # than the iOS 26 SDK (ITMS-90725, hit on 2026-10-23 with an Xcode 16.4
    # build), and React Native 0.77 does not compile on Xcode 26:
    #
    #   call to consteval function 'fmt::basic_format_string<...>' is not a
    #   constant expression
    #
    # Xcode 26's clang advertises __cpp_consteval, so fmt turns FMT_USE_CONSTEVAL
    # on and takes a path that same compiler then rejects. There is no older
    # toolchain left to retreat to - Apple's floor and RN's ceiling now overlap -
    # so the header is patched instead.
    #
    # A -DFMT_USE_CONSTEVAL=0 compiler flag DOES NOT WORK. React Native pins
    # fmt 11.0.2 through RCT-Folly, and in 11.0.2 the macro is defined by an
    # unguarded #if/#elif chain that overwrites anything passed with -D. The
    # `#ifdef FMT_USE_CONSTEVAL` guard that would make flags work only arrived in
    # fmt 12.1.0, which React Native has not taken yet.
    #
    # This RAISES rather than skipping when it finds nothing to patch. The
    # documented failure mode of every version of this workaround is that the
    # pattern stops matching after a dependency bump, the hook silently does
    # nothing, and the identical build failure returns ~15 minutes later looking
    # like a fresh problem. A loud failure at pod-install time is far cheaper.
    #
    # Remove this whole block when React Native ships fmt >= 12.1.0.
    fmt_header = nil
    ['fmt/include/fmt/base.h', 'fmt/include/fmt/core.h'].each do |rel|
      candidate = File.join(installer.sandbox.root, rel)
      fmt_header = candidate if File.exist?(candidate)
      break if fmt_header
    end

    if fmt_header.nil?
      raise 'fmt patch: could not find fmt/include/fmt/base.h or core.h under ' \
            "#{installer.sandbox.root}. The fmt pod moved or is gone - check " \
            'whether React Native still vendors fmt before deleting this hook.'
    end

    fmt_source = File.read(fmt_header)
    patched = fmt_source.gsub(/^(\s*#\s*define\s+FMT_USE_CONSTEVAL\s+).*$/) { |_| "#{$1}0" }

    if patched == fmt_source
      raise "fmt patch: no FMT_USE_CONSTEVAL definition found in #{fmt_header}. " \
            'If fmt is now >= 12.1.0 the macro is #ifdef-guarded and this hook ' \
            'should be deleted; otherwise the pattern needs updating. Failing ' \
            'loudly on purpose - silently skipping reproduces the original ' \
            'consteval build failure much later and much less obviously.'
    end

    File.write(fmt_header, patched)
    Pod::UI.puts "Patched #{File.basename(fmt_header)}: FMT_USE_CONSTEVAL forced to 0 (Xcode 26 + fmt 11.0.2)".green

    bump.call(installer.pods_project)
    if installer.respond_to?(:pod_target_subprojects)
      installer.pod_target_subprojects.each { |subproject| bump.call(subproject) }
    end
  end
end
