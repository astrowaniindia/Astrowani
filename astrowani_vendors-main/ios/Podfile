# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported   # 15.1 for RN 0.77 - keep the Xcode
                                           # project's IPHONEOS_DEPLOYMENT_TARGET
                                           # matching, or pods and app disagree.
prepare_react_native_project!

# ---------------------------------------------------------------------------
# NOTE: there is deliberately NO setup_permissions! block here.
#
# The customer app's Podfile has one because react-native-permissions is a
# dependency there. This app does NOT have that package installed at all, so
# adding `require_relative '../node_modules/react-native-permissions/...'`
# would abort `pod install` with a file-not-found before anything else runs.
#
# It is not needed for correctness either: iOS prompts for the microphone and
# camera automatically on the first getUserMedia call, and the denial path is
# now handled explicitly in EnxScreenVoice / EnxScreenVideo / GoLiveScreen.
# If react-native-permissions is ever added to this app, the block goes right
# here, listing Camera / Microphone / Notifications / PhotoLibrary (this app
# uses NO location - verified, there is no Geolocation usage in src/).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# FIRST-BUILD TROUBLESHOOTING - read this before changing anything here.
#
# This app links react-native-webrtc + @react-native-firebase/* +
# react-native-image-crop-picker + react-native-audio-recorder-player +
# @notifee/react-native + react-native-fs. Try in this order, changing ONE
# thing at a time:
#
#   1. Plain `pod install` (this file as-is). Firebase's iOS SDK supports
#      static libraries, so this usually just works. Try it first.
#
#   2. If Swift/modular-header errors appear (typically from
#      FirebaseCoreInternal or GoogleUtilities), rebuild with static
#      frameworks:
#         USE_FRAMEWORKS=static pod install
#      The `linkage` block below already reads that env var, and
#      $RNFirebaseAsStaticFramework is set for exactly this case.
#
#   3. react-native-image-crop-picker is the most likely straggler under
#      static frameworks - it vendors TOCropViewController/QBImagePicker. If it
#      is the only thing failing, give it `:modular_headers => true` rather
#      than changing global linkage.
#
#   4. Do NOT reach for `use_frameworks! :linkage => :dynamic` -
#      react-native-webrtc does not cooperate with it.
#
# All of this app's patches/ are Android-only (verified: zero ios/ references),
# so patch-package is not a factor in an iOS build failure.
#
# Never commit a Podfile.lock produced by an experiment that did not build.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LINKAGE - settled empirically on the customer app; kept identical here so the
# two apps do not diverge. See that Podfile for the full reasoning.
#
# Short version: pod install fails without this because RNSentry (Swift) needs
# React-hermes to define modules, and FirebaseCoreInternal (Swift) needs the
# same of GoogleUtilities. use_frameworks! :linkage => :static also fixes that,
# but it broke linking of vendored xcframeworks on the customer app, so we use
# module maps and keep static LIBRARY linkage instead.
#
# DO NOT set USE_FRAMEWORKS. The env hook below is only an escape hatch, and
# :dynamic in particular does not work with react-native-webrtc.
# ---------------------------------------------------------------------------
use_modular_headers!
# Required when Firebase is built as a static framework (path 2 above).
# Harmless otherwise.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AstroIndia_Astrologers' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'AstroIndia_AstrologersTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
